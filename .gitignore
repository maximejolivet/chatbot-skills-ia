# Environment variables (.env.$APP_ENV.local covers any env: dev, prod,
# test, staging... rather than enumerating specific names)
.env
.env.local
.env.*.local

# Bruno environment files hold real credentials (admin password) -- request
# definitions in bruno/*.bru stay committed, only environments/*.bru (the
# actual values) are local.
bruno/environments/

