{% extends 'admin/layout.html.twig' %}

{% set item_actions = resources.definition.hasActionGroup('item') ? resources.definition.getActionGroup('item').actions : [] %}
{% set main_actions = resources.definition.hasActionGroup('main') ? resources.definition.getActionGroup('main').actions : [] %}

{% block title %}{{ metadata.pluralName|capitalize }}{% endblock %}
{% block header %}{{ metadata.pluralName|capitalize|replace({'_': ' '}) }}{% endblock %}

{% block header_actions %}
    {% for action in main_actions %}
        <a href="{{ path(admin_route(metadata.name, action.type)) }}"
           class="inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
            + {{ action.label starts with 'sylius.' ? 'Créer' : action.label }}
        </a>
    {% endfor %}
{% endblock %}

{% block content %}
    <div class="rounded-xl border border-border bg-card text-card-foreground shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-border text-sm">
                <thead class="bg-muted/50">
                    <tr>
                        {% for field in resources.definition.enabledFields %}
                            <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">{{ field.label ?? field.name }}</th>
                        {% endfor %}
                        {% if item_actions is not empty %}
                            <th class="px-4 py-2.5 text-right font-medium text-muted-foreground">Actions</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    {% for row in resources.data %}
                        <tr class="transition-colors hover:bg-muted/50">
                            {% for field in resources.definition.enabledFields %}
                                <td class="px-4 py-2.5 text-foreground">{{ admin_field_value(row, field.path ?? field.name) }}</td>
                            {% endfor %}
                            {% if item_actions is not empty %}
                                <td class="px-4 py-2.5 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1">
                                        {% for action in item_actions %}
                                            {% if action.type == 'delete' %}
                                                <form method="post" action="{{ path(admin_route(metadata.name, 'delete'), {id: row.id}) }}"
                                                      onsubmit="return confirm('Supprimer cet élément ?');" class="inline-flex">
                                                    <input type="hidden" name="_method" value="DELETE">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token(row.id) }}">
                                                    <button type="submit" title="Supprimer" aria-label="Supprimer"
                                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-destructive transition-colors hover:bg-destructive/10">
                                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                d="M4 7h16M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-9 0 1 13a2 2 0 002 2h6a2 2 0 002-2l1-13" />
                                                        </svg>
                                                    </button>
                                                </form>
                                            {% elseif action.type == 'show' %}
                                                <a href="{{ path(admin_route(metadata.name, action.type), {id: row.id}) }}"
                                                   title="Voir" aria-label="Voir"
                                                   class="inline-flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
                                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                            d="M2 12S5.5 5 12 5s10 7 10 7-3.5 7-10 7-10-7-10-7z" />
                                                        <circle cx="12" cy="12" r="3" stroke-width="2" />
                                                    </svg>
                                                </a>
                                            {% elseif action.type == 'update' %}
                                                <a href="{{ path(admin_route(metadata.name, action.type), {id: row.id}) }}"
                                                   title="Modifier" aria-label="Modifier"
                                                   class="inline-flex h-8 w-8 items-center justify-center rounded-md text-primary transition-colors hover:bg-primary/10">
                                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                            d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4 12.5-12.5z" />
                                                    </svg>
                                                </a>
                                            {% else %}
                                                <a href="{{ path(admin_route(metadata.name, action.type), {id: row.id}) }}"
                                                   class="inline-flex h-8 items-center rounded-md px-2 text-sm text-primary transition-colors hover:bg-primary/10">
                                                    {{ action.label }}
                                                </a>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ resources.definition.enabledFields|length + 1 }}" class="px-4 py-8 text-center text-muted-foreground">
                                Aucun élément.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if resources.data.haveToPaginate %}
            <div class="flex items-center justify-between px-4 py-3 border-t border-border text-sm text-muted-foreground">
                <span>Page {{ resources.data.currentPage }} / {{ resources.data.nbPages }} ({{ resources.data.nbResults }} au total)</span>
                <div class="space-x-2">
                    {% if resources.data.hasPreviousPage %}
                        <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({page: resources.data.previousPage})) }}" class="text-primary hover:underline">← Précédent</a>
                    {% endif %}
                    {% if resources.data.hasNextPage %}
                        <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({page: resources.data.nextPage})) }}" class="text-primary hover:underline">Suivant →</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
