{% form_theme form 'admin/form_theme.html.twig' %}

<div class="bg-white rounded-lg border border-slate-200 p-6 max-w-2xl">
    {{ form_start(form) }}
        {{ form_widget(form) }}

        <div class="mt-6 flex items-center gap-3">
            <button type="submit" class="inline-flex items-center rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
                Enregistrer
            </button>
            <a href="{{ path(admin_route(metadata.name, 'index')) }}" class="text-sm text-slate-600 hover:text-slate-900">
                Annuler
            </a>
        </div>
    {{ form_end(form) }}
</div>
