{% extends 'admin/layout.html.twig' %}

{% block title %}{{ metadata.name|humanize }} #{{ resource.id }}{% endblock %}
{% block header %}{{ metadata.name|humanize }} #{{ resource.id }}{% endblock %}

{% block header_actions %}
    <a href="{{ path(admin_route(metadata.name, 'index')) }}" class="text-sm text-muted-foreground hover:text-foreground">← Retour à la liste</a>
{% endblock %}

{% block content %}
    <div class="rounded-xl border border-border bg-card text-card-foreground shadow-sm p-6 max-w-2xl">
        <dl class="divide-y divide-border">
            {% for field in admin_grid_fields(metadata.name) %}
                <div class="py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm font-medium text-muted-foreground">{{ field.label ?? field.name }}</dt>
                    <dd class="text-sm text-foreground col-span-2 whitespace-pre-wrap">{{ admin_field_value(resource, field.path ?? field.name) }}</dd>
                </div>
            {% endfor %}
        </dl>
    </div>
{% endblock %}
