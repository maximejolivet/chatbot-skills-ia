<!DOCTYPE html>
<html lang="fr" class="h-full bg-background">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Backoffice{% endblock %} · Chatbot Admin</title>
        {{ importmap('app') }}
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="h-full">
        <div class="flex h-full">
            <aside class="w-64 shrink-0 bg-sidebar text-sidebar-foreground flex flex-col">
                <div class="px-5 py-4 font-semibold text-lg border-b border-sidebar-border">
                    Chatbot Admin
                </div>
                <nav class="flex-1 overflow-y-auto py-4 space-y-6">
                    {% for group in admin_nav() %}
                        <div class="px-3">
                            <p class="px-2 text-xs font-semibold uppercase tracking-wider text-sidebar-foreground/50 mb-1">{{ group.label }}</p>
                            <ul class="space-y-0.5">
                                {% for item in group.items %}
                                    <li>
                                        <a href="{{ path(item.route) }}"
                                           class="block rounded-md px-2 py-1.5 text-sm transition-colors {{ app.request.attributes.get('_route') starts with 'app_admin_' ~ item.resource ~ '_' ? 'bg-sidebar-primary text-sidebar-primary-foreground' : 'text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground' }}">
                                            {{ item.label }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </nav>
                <div class="px-5 py-3 text-xs text-sidebar-foreground/50 border-t border-sidebar-border">
                    <a href="{{ path('app_admin_dashboard') }}" class="hover:text-sidebar-foreground">← Accueil admin</a><br>
                    <a href="/api" class="hover:text-sidebar-foreground">API Platform</a> · <a href="/doc" class="hover:text-sidebar-foreground">Swagger</a><br>
                    <a href="{{ path('app_admin_logout') }}" class="hover:text-sidebar-foreground">Se déconnecter</a>
                </div>
            </aside>

            <div class="flex-1 flex flex-col min-w-0">
                <header class="bg-background border-b border-border px-8 py-4 flex items-center justify-between">
                    <h1 class="text-xl font-semibold text-foreground">{% block header %}{% endblock %}</h1>
                    <div>{% block header_actions %}{% endblock %}</div>
                </header>

                <main class="flex-1 overflow-y-auto p-8">
                    {% for label, messages in app.flashes(['success', 'error']) %}
                        {% for message in messages %}
                            <div class="mb-4 rounded-md px-4 py-3 text-sm border {{ label == 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-destructive/30 bg-destructive/10 text-destructive' }}">
                                {% if message is iterable %}
                                    {{ message.message|trans(message.parameters|default({}), 'flashes') }}
                                {% else %}
                                    {{ message|trans([], 'flashes') }}
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block content %}{% endblock %}
                </main>
            </div>
        </div>
    </body>
</html>
