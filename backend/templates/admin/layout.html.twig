<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Backoffice{% endblock %} · Chatbot Admin</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: {
                                50: '#eef2ff', 100: '#e0e7ff', 500: '#6366f1',
                                600: '#4f46e5', 700: '#4338ca', 900: '#312e81',
                            },
                        },
                    },
                },
            };
        </script>
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="h-full">
        <div class="flex h-full">
            <aside class="w-64 shrink-0 bg-slate-900 text-slate-200 flex flex-col">
                <div class="px-5 py-4 text-white font-semibold text-lg border-b border-slate-800">
                    Chatbot Admin
                </div>
                <nav class="flex-1 overflow-y-auto py-4 space-y-6">
                    {% for group in admin_nav() %}
                        <div class="px-3">
                            <p class="px-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">{{ group.label }}</p>
                            <ul class="space-y-0.5">
                                {% for item in group.items %}
                                    <li>
                                        <a href="{{ path(item.route) }}"
                                           class="block rounded-md px-2 py-1.5 text-sm {{ app.request.attributes.get('_route') starts with 'app_admin_' ~ item.resource ~ '_' ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white' }}">
                                            {{ item.label }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </nav>
                <div class="px-5 py-3 text-xs text-slate-500 border-t border-slate-800">
                    <a href="{{ path('app_admin_dashboard') }}" class="hover:text-slate-300">← Accueil admin</a><br>
                    <a href="/api" class="hover:text-slate-300">API Platform</a> · <a href="/doc" class="hover:text-slate-300">Swagger</a><br>
                    <a href="{{ path('app_admin_logout') }}" class="hover:text-slate-300">Se déconnecter</a>
                </div>
            </aside>

            <div class="flex-1 flex flex-col min-w-0">
                <header class="bg-white border-b border-slate-200 px-8 py-4 flex items-center justify-between">
                    <h1 class="text-xl font-semibold text-slate-900">{% block header %}{% endblock %}</h1>
                    <div>{% block header_actions %}{% endblock %}</div>
                </header>

                <main class="flex-1 overflow-y-auto p-8">
                    {% for label, messages in app.flashes(['success', 'error']) %}
                        {% for message in messages %}
                            <div class="mb-4 rounded-md px-4 py-3 text-sm {{ label == 'success' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200' }}">
                                {% if message is iterable %}
                                    {{ message.message|trans(message.parameters|default({}), 'flashes') }}
                                {% else %}
                                    {{ message|trans([], 'flashes') }}
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block content %}{% endblock %}
                </main>
            </div>
        </div>
    </body>
</html>
