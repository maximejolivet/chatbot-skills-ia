{% extends 'admin/crud/show.html.twig' %}

{% block content %}
    {{ parent() }}

    <div class="rounded-xl border border-border bg-card text-card-foreground shadow-sm p-6 max-w-2xl mt-6">
        <h2 class="text-sm font-medium text-muted-foreground mb-4">Étapes ({{ resource.steps|length }})</h2>

        {% if resource.steps|length == 0 %}
            <p class="text-sm text-muted-foreground">Aucune étape configurée.</p>
        {% else %}
            <ol class="space-y-3">
                {% for step in resource.steps %}
                    <li class="border border-border rounded-md p-3 {{ step.isActive ? '' : 'opacity-50' }}">
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-muted-foreground font-mono">{{ loop.index }}.</span>
                            <span class="font-medium text-foreground">{{ step.name }}</span>
                            <span class="inline-flex items-center rounded bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground">
                                {{ admin_step_type_label(step) }}
                            </span>
                            {% if not step.isActive %}
                                <span class="text-xs text-muted-foreground">(désactivée)</span>
                            {% endif %}
                        </div>
                        <p class="text-sm text-muted-foreground mt-1.5">{{ admin_step_summary(step) }}</p>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </div>
{% endblock %}
