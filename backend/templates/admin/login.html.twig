<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Connexion · Chatbot Admin</title>
        {{ importmap('app') }}
    </head>
    <body class="h-full flex items-center justify-center">
        <div class="w-full max-w-sm">
            <h1 class="mb-6 text-center text-lg font-semibold text-slate-900">Chatbot Admin</h1>

            {% if error %}
                <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                    Identifiants invalides.
                </div>
            {% endif %}

            <form method="post" class="space-y-4 rounded-lg bg-white p-6 shadow ring-1 ring-slate-200">
                <div>
                    <label for="username" class="block text-sm font-medium text-slate-700 mb-1">Utilisateur</label>
                    <input type="text" id="username" name="_username" value="{{ last_username }}" required autofocus
                           class="block w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Mot de passe</label>
                    <input type="password" id="password" name="_password" required
                           class="block w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
                </div>
                <button type="submit"
                        class="w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
                    Se connecter
                </button>
            </form>
        </div>
    </body>
</html>
