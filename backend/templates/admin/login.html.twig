<!DOCTYPE html>
<html lang="fr" class="h-full bg-background">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Connexion · Chatbot Admin</title>
        {{ importmap('app') }}
    </head>
    <body class="h-full flex items-center justify-center">
        <div class="w-full max-w-sm">
            <h1 class="mb-6 text-center text-lg font-semibold text-foreground">Chatbot Admin</h1>

            {% if error %}
                <div class="mb-4 rounded-md border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive">
                    Identifiants invalides.
                </div>
            {% endif %}

            <form method="post" class="space-y-4 rounded-xl border border-border bg-card p-6 shadow-sm">
                <div>
                    <label for="username" class="block text-sm font-medium leading-none text-foreground mb-1.5">Utilisateur</label>
                    <input type="text" id="username" name="_username" value="{{ last_username }}" required autofocus
                           class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm text-foreground shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium leading-none text-foreground mb-1.5">Mot de passe</label>
                    <input type="password" id="password" name="_password" required
                           class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm text-foreground shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                </div>
                <button type="submit"
                        class="inline-flex h-9 w-full items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                    Se connecter
                </button>
            </form>
        </div>
    </body>
</html>
