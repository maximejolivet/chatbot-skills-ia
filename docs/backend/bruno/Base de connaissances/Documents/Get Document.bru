meta {
  name: Get Document
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/documents/{{document_id}}
  body: none
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

docs {
  Poll this after upload/process: status goes pending -> processing ->
  indexed/error. Includes chunks[] with vectorized + vectorId once done.
}
