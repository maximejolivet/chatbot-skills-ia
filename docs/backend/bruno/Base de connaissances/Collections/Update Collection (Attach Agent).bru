meta {
  name: Update Collection (Attach Agent)
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/collections/{{collection_id}}
  body: json
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

headers {
  Content-Type: application/merge-patch+json
}

body:json {
  {
    "agent": "/api/ai_agents/{{ai_agent_id}}"
  }
}

docs {
  This is the only way to link a Collection <-> AiAgent (OneToOne): AiAgent's
  own admin form has no field for it, since AiAgent is not writable over the
  API at all.
}
