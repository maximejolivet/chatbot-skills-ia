meta {
  name: Get FAQ
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/faqs/{{faq_id}}
  body: none
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

docs {
  Read-only, PUBLIC_ACCESS -- see List FAQs. Note: unlike the collection,
  this item route is not filtered by FaqActiveCollectionExtension (a
  QueryCollectionExtensionInterface), so an inactive FAQ is still readable
  by id if you already know it.
}
