meta {
  name: Create FAQ
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/faqs
  body: json
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

headers {
  Content-Type: application/ld+json
}

body:json {
  {
    "question": "Maxime Jolivet est-il disponible pour une mission en remote ?",
    "answer": "Ce point n'est pas precise dans le CV actuel ; a confirmer directement avec le candidat lors de l'entretien.",
    "category": "/api/document_categories/{{document_category_id}}",
    "isActive": true,
    "tags": ["disponibilite", "remote", "logistique"]
  }
}
