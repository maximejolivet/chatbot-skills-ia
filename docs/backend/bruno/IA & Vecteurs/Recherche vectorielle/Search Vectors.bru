meta {
  name: Search Vectors
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/vector/search
  body: json
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query": "experience et technologies backend de Maxime Jolivet",
    "collection_name": "cv_maxime_jolivet",
    "limit": 5
  }
}

docs {
  Custom controller, not an ApiResource -- snake_case fields (collection_name,
  category_id), plain application/json. Every successful call here is logged
  as a SearchQuery row (visible only in /admin/search-queries, no API for it).
}
