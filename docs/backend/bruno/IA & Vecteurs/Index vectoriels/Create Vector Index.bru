meta {
  name: Create Vector Index
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/vector_indices
  body: json
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

headers {
  Content-Type: application/ld+json
}

body:json {
  {
    "name": "cv-maxime-jolivet",
    "collectionId": "cv_maxime_jolivet",
    "dimension": 1024,
    "isActive": true
  }
}

docs {
  collectionId is the actual Qdrant collection name. dimension must match
  the embedding provider's output size (1024 for mxbai-embed-large).
}
