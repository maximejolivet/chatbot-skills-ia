meta {
  name: Update Vector Index
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/vector_indices/{{vector_index_id}}
  body: json
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

headers {
  Content-Type: application/merge-patch+json
}

body:json {
  {
    "isActive": true
  }
}
