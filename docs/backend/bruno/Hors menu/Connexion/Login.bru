meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/admin/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  _username: {{admin_username}}
  _password: {{admin_password}}
}

docs {
  Session-based form login for the `admin` firewall -- distinct from the
  `api` firewall's stateless HTTP Basic used by every other request in this
  collection. No CSRF token on this form (checked: the login page only has
  _username/_password inputs, unlike the resource create/edit forms which do
  have one). On success: 302 to /admin/, and Bruno's cookie jar picks up the
  PHPSESSID for subsequent /admin/* requests in "Utilisateurs" below.
}
