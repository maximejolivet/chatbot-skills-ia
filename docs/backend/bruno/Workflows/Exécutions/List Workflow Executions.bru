meta {
  name: List Workflow Executions
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/workflow_executions
  body: none
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

docs {
  Read-only. Owner-restricted for non-admin accounts (OwnershipVoter on
  triggeredBy) -- ROLE_ADMIN sees everything.
}
