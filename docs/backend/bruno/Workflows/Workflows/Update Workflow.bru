meta {
  name: Update Workflow
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/workflows/{{workflow_id}}
  body: json
  auth: basic
}

auth:basic {
  username: {{admin_username}}
  password: {{admin_password}}
}

headers {
  Content-Type: application/merge-patch+json
}

body:json {
  {
    "status": "active"
  }
}
